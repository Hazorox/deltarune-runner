[sub_resource type="GDScript" id="GDScript_0hvcy"]
resource_name = "difficulty_chooser"
script/source = "extends HBoxContainer
@onready var easy = $easy
@onready var normal = $normal
@onready var hard = $hard
@onready var buttons = [easy,normal,hard]
enum difficulties {easy,normal,hard}
var current = difficulties.normal
func _ready()->void:
	normal.grab_focus()

func _process(delta: float) -> void:
	if Input.is_action_just_pressed(\"right\"):
			current = (current + 1) % buttons.size()
			buttons[current].grab_focus()
	elif Input.is_action_just_pressed(\"left\"):
			current = (current - 1 + buttons.size()) % buttons.size()
			buttons[current].grab_focus()

func _on_easy_pressed() -> void:
	game.difficulty = difficulties.easy
	game.level_chosen = true
	game.difficulty_chosen.emit()


func _on_normal_pressed() -> void:
	game.difficulty = difficulties.normal
	game.level_chosen = true
	game.difficulty_chosen.emit()
	

func _on_hard_pressed() -> void:
	game.difficulty = difficulties.hard
	game.level_chosen = true
	game.difficulty_chosen.emit()
"

