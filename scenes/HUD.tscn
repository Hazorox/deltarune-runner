[sub_resource type="GDScript" id="GDScript_qpvh6"]
resource_name = "HUDScript"
script/source = "extends CanvasLayer
@onready var esc_menu = $escMenu
@onready var level_choice = $\"level-chooser\"
func _ready()->void:
	process_mode=Node.PROCESS_MODE_ALWAYS

func _process(_delta: float) -> void:
	if game.mode == null:
		return
	if not game.level_chosen:
		level_choice.visible=true
	else:
		if level_choice.visible:
			level_choice.visible=false
	if game.paused:
		esc_menu.visible=true
	else:
		if esc_menu.visible:
			esc_menu.visible=false
"

[sub_resource type="LabelSettings" id="LabelSettings_xlq6p"]
font = ExtResource("1_0oo48")

[sub_resource type="GDScript" id="GDScript_nt7q6"]
script/source = "extends Label

# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	if not game.mode:
		return
	if game.mode == \"tower\":
		text = \"Current Score : \" + str(game.tower_score)+\"\\n\" + \"HI Score : \" +str(game.tower_hi)
	
"

[sub_resource type="GDScript" id="GDScript_1etfg"]
resource_name = "menu_buttons"
script/source = "extends VBoxContainer

@onready var btn1 = $continue
@onready var btn2 = $leave
@onready var next = \"btn2\"

func _ready()->void:
	process_mode=Node.PROCESS_MODE_ALWAYS
	btn1.grab_focus()
func _process(delta: float) -> void:
	if Input.is_action_just_pressed(\"down\") or Input.is_action_just_pressed(\"up\"):
		if next==\"none\":
			btn1.grab_focus()
			next=\"btn2\"
		elif next==\"btn1\":
			btn1.grab_focus()
			next=\"btn2\"
		else:
			btn2.grab_focus()
			next=\"btn1\"

func _on_leave_pressed() -> void:
	game.pause(false)
	game.mode=null
	game.difficulty = 1
	game.level_chosen=false
	get_tree().change_scene_to_file(\"res://scenes/menu.tscn\")

func _on_continue_pressed() -> void:
	game.pause(false)
"

