[sub_resource type="GDScript" id="GDScript_yqeox"]
resource_name = "menu_buttons"
script/source = "extends VBoxContainer

@onready var btn1 = $Tower
@onready var btn2 = $Runner
@onready var next = \"none\"
# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	if Input.is_action_just_pressed(\"down\") or Input.is_action_just_pressed(\"up\"):
		if next==\"none\":
			btn1.grab_focus()
			next=\"btn2\"
		elif next==\"btn1\":
			btn1.grab_focus()
			next=\"btn2\"
		else:
			btn2.grab_focus()
			next=\"btn1\"

func _on_tower_pressed() -> void:
	get_tree().change_scene_to_file(\"res://scenes/tower_start.tscn\")
	game.mode=\"tower\"

func _on_runner_pressed() -> void:
	get_tree().change_scene_to_file(\"res://scenes/runner.tscn\")
	game.mode=\"runner\"
"

